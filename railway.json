{
  "build": { "builder": "NIXPACKS" },
  "deploy": {
    "startCommand": "gunicorn config.asgi:application -k uvicorn.workers.UvicornWorker --bind 127.0.0.1:8000 --workers 4 --timeout 30 --max-requests 10000 --max-requests-jitter 1000",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}